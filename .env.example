# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Connection String (e.g. mongodb+srv://user:pass@cluster.mongodb.net/withu or mongodb://localhost:27017/withu)
MONGODB_URI=
MONGODB_DB_NAME=withu_database

# Firebase Client Configuration
# VITE_API_URL=

# Backend API base URL used by the browser at runtime. In production (Vercel)
# this MUST be set to the Render backend (e.g. https://withu-server.onrender.com)
# so /api/* and ws:// requests reach Express instead of returning 404 from
# the static Vercel host. Leave empty for local dev (Vite proxy handles /api).
VITE_API_BASE_URL=

VITE_apiKey=
VITE_authDomain=
VITE_projectId=
VITE_storageBucket=
VITE_messagingSenderId=
VITE_appId=

# ImgBB key for the profile-photo upload on the register page.
# Must carry the VITE_ prefix or the browser cannot read it.
VITE_IMAGE_BB_API_KEY=
